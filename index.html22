<!doctype html>
<html lang="ru">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<meta name="theme-color" content="#17202b">
<title>Мой языковой тренажёр</title>
<style>
:root{color-scheme:light dark;--bg:#111820;--panel:#1b2632;--panel2:#243241;--text:#f1f5f9;--muted:#aab8c6;--line:#394a5b;--accent:#8bc5ff;--good:#8fe0b1;--bad:#ff9c9c}
*{box-sizing:border-box}body{margin:0;background:var(--bg);color:var(--text);font:16px/1.45 system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif}
header{padding:22px 16px 14px;max-width:1050px;margin:auto}h1{font-size:clamp(24px,4vw,34px);margin:0 0 6px}p{margin:6px 0}.muted{color:var(--muted)}main{max-width:1050px;margin:auto;padding:0 16px 40px}
nav{display:flex;gap:8px;flex-wrap:wrap;margin:12px 0 18px}.tab,button{border:1px solid var(--line);border-radius:10px;background:var(--panel2);color:var(--text);padding:10px 13px;font:inherit;cursor:pointer}.tab.active{background:var(--accent);color:#10202c;border-color:var(--accent);font-weight:700}button.primary{background:var(--accent);color:#10202c;border-color:var(--accent);font-weight:700}button.danger{border-color:#8e4545}.panel{background:var(--panel);border:1px solid var(--line);border-radius:16px;padding:18px;margin:12px 0}.grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px}.field{display:flex;flex-direction:column;gap:5px}.field.full{grid-column:1/-1}label{font-size:14px;color:var(--muted)}input,select,textarea{width:100%;background:var(--bg);color:var(--text);border:1px solid var(--line);border-radius:9px;padding:11px;font:inherit;min-width:0}textarea{min-height:90px;resize:vertical}.actions{display:flex;gap:8px;flex-wrap:wrap;margin-top:12px}.stats{display:grid;grid-template-columns:repeat(3,1fr);gap:8px}.stat{background:var(--panel2);border-radius:12px;padding:12px}.stat strong{display:block;font-size:24px}.hidden{display:none!important}.study-prompt{font-size:clamp(22px,4vw,30px);font-weight:700;margin:14px 0}.study-answer{font-size:20px;margin:10px 0}.pill{display:inline-block;border:1px solid var(--line);border-radius:999px;padding:3px 9px;font-size:12px;color:var(--muted);margin-right:5px}.feedback{padding:10px;border-radius:9px;margin-top:10px}.correct{background:#173c2b;color:#baf5d1}.incorrect{background:#482525;color:#ffd0d0}.list{display:grid;gap:8px}.item{border:1px solid var(--line);border-radius:11px;padding:12px;display:flex;gap:12px;align-items:flex-start;justify-content:space-between}.itemmain{min-width:0;overflow-wrap:anywhere}.itemtitle{font-weight:700}.smallbtn{padding:6px 9px;font-size:14px}.help{font-size:13px;color:var(--muted)}.progress{height:8px;border-radius:20px;background:var(--panel2);overflow:hidden;margin-top:8px}.progress>div{height:100%;background:var(--accent);width:0}.rating{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:7px}.rating button{padding:9px 4px}.section-title{margin:0 0 12px;font-size:21px}footer{max-width:1050px;margin:auto;padding:0 16px 30px;color:var(--muted);font-size:13px}
@media(max-width:650px){.grid{grid-template-columns:1fr}.stats{grid-template-columns:repeat(3,1fr)}.panel{padding:14px}.item{flex-direction:column}.rating{grid-template-columns:repeat(2,minmax(0,1fr))}}
</style>
</head>
<body>
<header>
<h1>Мой языковой тренажёр</h1>
<p class="muted">Слова, глаголы, ввод ответов и интервальные повторения. Данные хранятся в этом браузере.</p>
<nav>
<button class="tab active" data-tab="study">Повторение</button>
<button class="tab" data-tab="addword">Добавить слово</button>
<button class="tab" data-tab="addverb">Добавить глагол</button>
<button class="tab" data-tab="search">Поиск и словарь</button>
<button class="tab" data-tab="backup">Резервная копия</button>
</nav>
</header>
<main>
<section id="study" class="view">
<div class="stats">
<div class="stat"><span class="muted">К повторению</span><strong id="dueCount">0</strong></div>
<div class="stat"><span class="muted">Новые</span><strong id="newCount">0</strong></div>
<div class="stat"><span class="muted">Всего карточек</span><strong id="totalCount">0</strong></div>
</div>
<div class="panel">
<h2 class="section-title">Настройки занятия</h2>
<div class="grid">
<div class="field"><label for="studyKind">Что тренировать</label><select id="studyKind"><option value="all">Всё</option><option value="word">Только слова</option><option value="verb">Только глаголы</option></select></div>
<div class="field"><label for="studyDeck">Направление</label><select id="studyDeck"><option value="all">Все направления</option><option>Russian → English</option><option>Russian + English → Czech</option><option>English → Czech</option><option>Мои слова</option><option>Мои глаголы</option></select></div>
<div class="field"><label for="newLimit">Лимит новых карточек за день</label><input id="newLimit" type="number" min="0" max="500" value="20"></div>
<div class="field"><label for="sessionLimit">Карточек в занятии</label><input id="sessionLimit" type="number" min="1" max="500" value="30"></div>
</div>
<div class="actions"><button class="primary" id="startBtn">Начать занятие</button><button id="resetSessionBtn">Сбросить занятие</button></div>
</div>
<div id="studyArea" class="panel hidden">
<div><span class="pill" id="cardKind"></span><span class="pill" id="cardDeck"></span><span class="pill" id="cardProgress"></span></div>
<div id="prompt" class="study-prompt"></div>
<div id="hint" class="muted"></div>
<form id="answerForm">
<div class="field"><label for="answerInput">Твой ответ</label><input id="answerInput" autocomplete="off" autocapitalize="off" spellcheck="false" placeholder="Введи перевод или формы глагола"></div>
<div class="actions"><button class="primary" type="submit">Проверить</button><button type="button" id="showAnswerBtn">Показать ответ</button></div>
</form>
<div id="feedback" class="hidden"></div>
<div id="answerBlock" class="hidden">
<div class="study-answer" id="correctAnswer"></div>
<div id="pronunciation" class="muted"></div>
<p class="help">Оцени, насколько легко вспомнил ответ. Это определит следующий интервал.</p>
<div class="rating">
<button data-rating="again">Снова<br><span class="help">1 мин</span></button>
<button data-rating="hard">Трудно<br><span class="help">короткий</span></button>
<button data-rating="good">Хорошо<br><span class="help">обычный</span></button>
<button data-rating="easy">Легко<br><span class="help">длинный</span></button>
</div>
</div>
</div>
<div id="emptyStudy" class="panel"><h2 class="section-title">Готов к повторению</h2><p class="muted">Нажми «Начать занятие». Карточки на повторение будут появляться раньше новых.</p></div>
</section>

<section id="addword" class="view hidden">
<div class="panel">
<h2 class="section-title">Добавить слово или фразу</h2>
<form id="wordForm" class="grid">
<div class="field"><label for="wordPrompt">Что показывать в задании</label><input id="wordPrompt" required placeholder="Например: идти"></div>
<div class="field"><label for="wordAnswer">Правильный ответ</label><input id="wordAnswer" required placeholder="Например: go"></div>
<div class="field"><label for="wordDeck">Направление</label><select id="wordDeck"><option>Russian → English</option><option>Russian + English → Czech</option><option>English → Czech</option><option>Моё направление</option></select></div>
<div class="field"><label for="wordPron">Произношение / подсказка (необязательно)</label><input id="wordPron" placeholder="Например: гоу"></div>
<div class="field full"><label for="wordTags">Теги (необязательно)</label><input id="wordTags" placeholder="например: работа, повседневное"></div>
<div class="field full"><button class="primary" type="submit">Добавить слово</button></div>
</form>
<p class="help">Новое слово сразу попадёт в словарь и будет доступно для повторения. Проверка ответа игнорирует регистр, лишние пробелы и разделительные запятые/точки с запятой.</p>
</div>
</section>

<section id="addverb" class="view hidden">
<div class="panel">
<h2 class="section-title">Добавить глагол</h2>
<form id="verbForm" class="grid">
<div class="field"><label for="verbLang">Язык</label><select id="verbLang"><option value="Czech">Чешский</option><option value="English">Английский</option></select></div>
<div class="field"><label for="verbInf">Инфинитив / начальная форма</label><input id="verbInf" required placeholder="dělat / go"></div>
<div class="field"><label for="verbMeaning">Перевод</label><input id="verbMeaning" required placeholder="делать / идти"></div>
<div class="field"><label for="verbTense">Время или тип форм</label><input id="verbTense" required placeholder="Настоящее время / Past Simple"></div>
<div class="field full"><label for="verbForms">Формы по порядку</label><textarea id="verbForms" required placeholder="Чешский: dělám, děláš, dělá, děláme, děláte, dělají&#10;Английский: go, went, gone"></textarea></div>
<div class="field full"><label for="verbPron">Произношение / подсказка (необязательно)</label><input id="verbPron" placeholder="Можно указать формы через запятую"></div>
<div class="field full"><button class="primary" type="submit">Добавить глагол</button></div>
</form>
<p class="help">В упражнении нужно будет ввести все формы по порядку. Пробелы, запятые и точки с запятой между формами не влияют на проверку. Порядок форм важен.</p>
</div>
</section>

<section id="search" class="view hidden">
<div class="panel">
<h2 class="section-title">Поиск и словарь</h2>
<div class="grid">
<div class="field full"><label for="searchInput">Искать по слову, переводу, глаголу или подсказке</label><input id="searchInput" placeholder="Начни вводить текст…"></div>
<div class="field"><label for="searchKind">Тип</label><select id="searchKind"><option value="all">Все</option><option value="word">Слова</option><option value="verb">Глаголы</option></select></div>
<div class="field"><label for="searchSource">Источник</label><select id="searchSource"><option value="all">Все</option><option value="seed">Исходный словарь</option><option value="user">Добавленные мной</option></select></div>
</div>
<p class="muted" id="searchCount"></p>
<div id="results" class="list"></div>
</div>
</section>

<section id="backup" class="view hidden">
<div class="panel">
<h2 class="section-title">Резервная копия</h2>
<p>Экспорт сохраняет слова, глаголы, интервалы повторения и статистику. Импорт позволяет восстановить копию или объединить её с текущим словарём.</p>
<div class="actions"><button class="primary" id="exportBtn">Скачать резервную копию</button><label class="tab" for="importFile">Импортировать копию</label><input id="importFile" type="file" accept=".json,application/json" class="hidden"></div>
<p class="help">Данные хранятся локально в этом браузере. Для переноса на другой телефон или компьютер экспортируй копию здесь, а затем импортируй её на другом устройстве. Не очищай данные браузера без резервной копии.</p>
<div id="backupMsg" class="muted"></div>
</div>
</section>
</main>
<footer>Локальный тренажёр. Не требует аккаунта и не отправляет словарь на сервер. Автоматической синхронизации между устройствами нет — для переноса используй резервную копию.</footer>

<script>
const SEED = [{"id":"seed1","kind":"word","deck":"Russian → English","prompt":"абсолютно","answer":"definitely","pron":"дэфинитли","tags":"english ru-en","source":"Исходный словарь","due":0,"interval":0,"ease":2.5,"reps":0,"lapses":0},{"id":"seed2","kind":"word","deck":"Russian → English","prompt":"австралия","answer":"Australia","pron":"острэйлия","tags":"english ru-en","source":"Исходный словарь","due":0,"interval":0,"ease":2.5,"reps":0,"lapses":0},{"id":"seed3","kind":"word","deck":"Russian → English","prompt":"автомобиль (машина)","answer":"auto","pron":"ото","tags":"english ru-en","source":"Исходный словарь","due":0,"interval":0,"ease":2.5,"reps":0,"lapses":0},{"id":"seed4","kind":"word","deck":"Russian → English","prompt":"актив","answer":"asset","pron":"эсэт","tags":"english ru-en","source":"Исходный словарь","due":0,"interval":0,"ease":2.5,"reps":0,"lapses":0},{"id":"seed5","kind":"word","deck":"Russian → English","prompt":"активность","answer":"activity","pron":"эктивэти","tags":"english ru-en","source":"Исходный словарь","due":0,"interval":0,"ease":2.5,"reps":0,"lapses":0},{"id":"seed6","kind":"word","deck":"Russian → English","prompt":"алкоголь","answer":"drink","pron":"дринк","tags":"english ru-en","source":"Исходный словарь","due":0,"interval":0,"ease":2.5,"reps":0,"lapses":0},{"id":"seed7","kind":"word","deck":"Russian → English","prompt":"альбом","answer":"album","pron":"элбэм","tags":"english ru-en","source":"Исходный словарь","due":0,"interval":0,"ease":2.5,"reps":0,"lapses":0},{"id":"seed8","kind":"word","deck":"Russian → English","prompt":"американский","answer":"American","pron":"эмэрикэн","tags":"english ru-en","source":"Исходный словарь","due":0,"interval":0,"ease":2.5,"reps":0,"lapses":0},{"id":"seed9","kind":"word","deck":"Russian → English","prompt":"анализ","answer":"analysis","pron":"энэлисис","tags":"english ru-en","source":"Исходный словарь","due":0,"interval":0,"ease":2.5,"reps":0,"lapses":0},{"id":"seed10","kind":"word","deck":"Russian → English","prompt":"аренда","answer":"rent","pron":"рэнт","tags":"english ru-en","source":"Исходный словарь","due":0,"interval":0,"ease":2.5,"reps":0,"lapses":0},{"id":"seed11","kind":"word","deck":"Russian → English","prompt":"армия","answer":"army","pron":"арми","tags":"english ru-en","source":"Исходный словарь","due":0,"interval":0,"ease":2.5,"reps":0,"lapses":0},{"id":"seed12","kind":"word","deck":"Russian → English","prompt":"атлет","answer":"athlete","pron":"этлит","tags":"english ru-en","source":"Исходный словарь","due":0,"interval":0,"ease":2.5,"reps":0,"lapses":0},{"id":"seed13","kind":"word","deck":"Russian → English","prompt":"бабочка","answer":"butterfly","pron":"батэрфлай","tags":"english ru-en","source":"Исходный словарь","due":0,"interval":0,"ease":2.5,"reps":0,"lapses":0},{"id":"seed14","kind":"word","deck":"Russian → English","prompt":"багаж","answer":"luggage","pron":"лагэдж","tags":"english ru-en","source":"Исходный словарь","due":0,"interval":0,"ease":2.5,"reps":0,"lapses":0},{"id":"seed15","kind":"word","deck":"Russian → English","prompt":"багажник","answer":"trunk","pron":"транк","tags":"english ru-en","source":"Исходный словарь","due":0,"interval":0,"ease":2.5,"reps":0,"lapses":0},{"id":"seed16","kind":"word","deck":"Russian → English","prompt":"банан","answer":"banana","pron":"бэнэнэ","tags":"english ru-en","source":"Исходный словарь","due":0,"interval":0,"ease":2.5,"reps":0,"lapses":0},{"id":"seed17","kind":"word","deck":"Russian → English","prompt":"барабан","answer":"drum","pron":"драм","tags":"english ru-en","source":"Исходный словарь","due":0,"interval":0,"ease":2.5,"reps":0,"lapses":0},{"id":"seed18","kind":"word","deck":"Russian → English","prompt":"баскетбол","answer":"basketball","pron":"баскетбол","tags":"english ru-en","source":"Исходный словарь","due":0,"interval":0,"ease":2.5,"reps":0,"lapses":0},{"id":"seed19","kind":"word","deck":"Russian → English","prompt":"бегать","answer":"run","pron":"ран","tags":"english ru-en","source":"Исходный словарь","due":0,"interval":0,"ease":2.5,"reps":0,"lapses":0},{"id":"seed20","kind":"word","deck":"Russian → English","prompt":"бедность","answer":"poverty","pron":"повэти","tags":"english ru-en","source":"Исходный словарь","due":0,"interval":0,"ease":2.5,"reps":0,"lapses":0},{"id":"seed21","kind":"word","deck":"Russian → English","prompt":"бедный","answer":"poor","pron":"пур","tags":"english ru-en","source":"Исходный словарь","due":0,"interval":0,"ease":2.5,"reps":0,"lapses":0},{"id":"seed22","kind":"word","deck":"Russian → English","prompt":"бездомный","answer":"homeless","pron":"хоумлэс","tags":"english ru-en","source":"Исходный словарь","due":0,"interval":0,"ease":2.5,"reps":0,"lapses":0},{"id":"seed23","kind":"word","deck":"Russian → English","prompt":"безопасность","answer":"safety","pron":"сэйфти","tags":"english ru-en","source":"Исходный словарь","due":0,"interval":0,"ease":2.5,"reps":0,"lapses":0},{"id":"seed24","kind":"word","deck":"Russian → English","prompt":"безработица","answer":"unemployment","pron":"анэмплоймэнт","tags":"english ru-en","source":"Исходный словарь","due":0,"interval":0,"ease":2.5,"reps":0,"lapses":0},{"id":"seed25","kind":"word","deck":"Russian → English","prompt":"берег","answer":"coast","pron":"коуст","tags":"english ru-en","source":"Исходный словарь","due":0,"interval":0,"ease":2.5,"reps":0,"lapses":0},{"id":"seed26","kind":"word","deck":"Russian → English","prompt":"бесплатно","answer":"free","pron":"фри","tags":"english ru-en","source":"Исходный словарь","due":0,"interval":0,"ease":2.5,"reps":0,"lapses":0},{"id":"seed27","kind":"word","deck":"Russian → English","prompt":"беспокоиться","answer":"worry","pron":"вори","tags":"english ru-en","source":"Исходный словарь","due":0,"interval":0,"ease":2.5,"reps":0,"lapses":0},{"id":"seed28","kind":"word","deck":"Russian → English","prompt":"бесполезный","answer":"useless","pron":"юслэс","tags":"english ru-en","source":"Исходный словарь","due":0,"interval":0,"ease":2.5,"reps":0,"