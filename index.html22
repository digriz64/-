mpt":"warm","answer":"teplo","pron":"Русский: тепло; English pronunciation: уорм; Чешское произношение: тепло","tags":"czech en-cz","source":"Исходный словарь","due":0,"interval":0,"ease":2.5,"reps":0,"lapses":0},{"id":"seed1608","kind":"word","deck":"English → Czech","prompt":"only","answer":"pouze","pron":"Русский: только; English pronunciation: оунли; Чешское произношение: поузе","tags":"czech en-cz","source":"Исходный словарь","due":0,"interval":0,"ease":2.5,"reps":0,"lapses":0},{"id":"seed1609","kind":"word","deck":"English → Czech","prompt":"grass","answer":"tráva","pron":"Русский: трава; English pronunciation: грас; Чешское произношение: трава","tags":"czech en-cz","source":"Исходный словарь","due":0,"interval":0,"ease":2.5,"reps":0,"lapses":0},{"id":"seed1610","kind":"word","deck":"English → Czech","prompt":"restroom","answer":"záchod","pron":"Русский: туалет; English pronunciation: рэструм; Чешское произношение: заход","tags":"czech en-cz","source":"Исходный словарь","due":0,"interval":0,"ease":2.5,"reps":0,"lapses":0},{"id":"seed1611","kind":"word","deck":"English → Czech","prompt":"dinner","answer":"večeře","pron":"Русский: ужин; English pronunciation: динэ; Чешское произношение: ве́чэрже","tags":"czech en-cz","source":"Исходный словарь","due":0,"interval":0,"ease":2.5,"reps":0,"lapses":0},{"id":"seed1612","kind":"word","deck":"English → Czech","prompt":"street","answer":"ulice","pron":"Русский: улица; English pronunciation: стрит; Чешское произношение: улице","tags":"czech en-cz","source":"Исходный словарь","due":0,"interval":0,"ease":2.5,"reps":0,"lapses":0},{"id":"seed1613","kind":"word","deck":"English → Czech","prompt":"duck","answer":"kachna","pron":"Русский: утка; English pronunciation: дак; Чешское произношение: ка́хна","tags":"czech en-cz","source":"Исходный словарь","due":0,"interval":0,"ease":2.5,"reps":0,"lapses":0},{"id":"seed1614","kind":"word","deck":"English → Czech","prompt":"study","answer":"učit se","pron":"Русский: учиться; English pronunciation: стади; Чешское произношение: учит се; leech","tags":"czech en-cz","source":"Исходный словарь","due":0,"interval":0,"ease":2.5,"reps":0,"lapses":0},{"id":"seed1615","kind":"word","deck":"English → Czech","prompt":"bread","answer":"chléb","pron":"Русский: хлеб; English pronunciation: брэд; Чешское произношение: хлеб","tags":"czech en-cz","source":"Исходный словарь","due":0,"interval":0,"ease":2.5,"reps":0,"lapses":0},{"id":"seed1616","kind":"word","deck":"English → Czech","prompt":"want","answer":"chtít","pron":"Русский: хотеть; English pronunciation: уонт; Чешское произношение: ции-тим ции-тиш ции-ти ции-ти-мэ ции-ти-тэ ции-ти; chci chceš chce chceme chcete chtějí","tags":"czech en-cz","source":"Исходный словарь","due":0,"interval":0,"ease":2.5,"reps":0,"lapses":0},{"id":"seed1617","kind":"word","deck":"English → Czech","prompt":"flower","answer":"květina","pron":"Русский: цветок; English pronunciation: флауэ; Чешское произношение: кветина","tags":"czech en-cz","source":"Исходный словарь","due":0,"interval":0,"ease":2.5,"reps":0,"lapses":0},{"id":"seed1618","kind":"word","deck":"English → Czech","prompt":"tea","answer":"čaj","pron":"Русский: чай; English pronunciation: ти; Чешское произношение: чай","tags":"czech en-cz","source":"Исходный словарь","due":0,"interval":0,"ease":2.5,"reps":0,"lapses":0},{"id":"seed1619","kind":"word","deck":"English → Czech","prompt":"clean","answer":"čistý","pron":"Русский: чистый; English pronunciation: клин; Чешское произношение: чи́сты","tags":"czech en-cz","source":"Исходный словарь","due":0,"interval":0,"ease":2.5,"reps":0,"lapses":0},{"id":"seed1620","kind":"word","deck":"English → Czech","prompt":"what","answer":"co","pron":"Русский: что; English pronunciation: уот; Чешское произношение: цо","tags":"czech en-cz","source":"Исходный словарь","due":0,"interval":0,"ease":2.5,"reps":0,"lapses":0},{"id":"seed1621","kind":"word","deck":"English → Czech","prompt":"hat","answer":"klobouk","pron":"Русский: шляпа; English pronunciation: хэт; Чешское произношение: клобоук","tags":"czech en-cz","source":"Исходный словарь","due":0,"interval":0,"ease":2.5,"reps":0,"lapses":0},{"id":"seed1622","kind":"word","deck":"English → Czech","prompt":"apple","answer":"jablko","pron":"Русский: яблоко; English pronunciation: эпл; Чешское произношение: яблко","tags":"czech en-cz","source":"Исходный словарь","due":0,"interval":0,"ease":2.5,"reps":0,"lapses":0},{"id":"seed1623","kind":"word","deck":"English → Czech","prompt":"egg","answer":"vejce","pron":"Русский: яйцо; English pronunciation: эг; Чешское произношение: вейце","tags":"czech en-cz","source":"Исходный словарь","due":0,"interval":0,"ease":2.5,"reps":0,"lapses":0}];
const STORE_KEY = "languageTrainerIndependent_v1";
let cards = [];
let session = [];
let sessionIndex = 0;
let current = null;
let checked = false;
let sessionDone = 0;
let newSeenToday = 0;
let todayKey = new Date().toISOString().slice(0,10);

function uid(){return "c"+Date.now().toString(36)+Math.random().toString(36).slice(2,8)}
function load(){
  try{
    const saved=JSON.parse(localStorage.getItem(STORE_KEY)||"null");
    if(saved && Array.isArray(saved.cards)){
      cards=saved.cards;
      if(saved.day===todayKey) newSeenToday=saved.newSeenToday||0;
    }else{cards=SEED.map(c=>({...c}));save();}
  }catch(e){cards=SEED.map(c=>({...c}));}
  cards.forEach(c=>{if(!c.id)c.id=uid(); if(!Number.isFinite(c.due))c.due=0;if(!Number.isFinite(c.interval))c.interval=0;if(!Number.isFinite(c.ease))c.ease=2.5;if(!Number.isFinite(c.reps))c.reps=0;if(!Number.isFinite(c.lapses))c.lapses=0;});
  updateStats();
}
function save(){localStorage.setItem(STORE_KEY,JSON.stringify({cards,day:todayKey,newSeenToday}));updateStats();}
function normalize(s){return String(s||"").toLocaleLowerCase().normalize("NFC").replace(/[.,;:!?()[\]{}'"“”‘’'`]/g,"").replace(/\s+/g,"").trim();}
function fieldsFor(c){return [c.prompt,c.answer,c.pron,c.meaning,c.infinitive,c.tense,c.forms,c.deck,c.tags].filter(Boolean).join(" ").toLocaleLowerCase()}
function isDue(c){return !c.due || c.due<=Date.now()}
function updateStats(){
 const eligible=cards.filter(c=>document.getElementById("studyKind")?.value==="all"||!document.getElementById("studyKind")||c.kind===document.getElementById("studyKind").value);
 document.getElementById("dueCount").textContent=eligible.filter(c=>c.reps>0&&isDue(c)).length;
 document.getElementById("newCount").textContent=eligible.filter(c=>c.reps===0).length;
 document.getElementById("totalCount").textContent=cards.length;
}
function showTab(id){
 document.querySelectorAll(".view").forEach(v=>v.classList.toggle("hidden",v.id!==id));
 document.querySelectorAll(".tab[data-tab]").forEach(b=>b.classList.toggle("active",b.dataset.tab===id));
 if(id==="search")renderSearch();
 updateStats();
}
document.querySelectorAll(".tab[data-tab]").forEach(b=>b.addEventListener("click",()=>showTab(b.dataset.tab)));
function deckMatch(c,deck){if(deck==="all")return true;if(deck==="Мои слова")return c.kind==="word"&&c.source==="user";if(deck==="Мои глаголы")return c.kind==="verb";return c.deck===deck}
function makeSession(){
 const kind=document.getElementById("studyKind").value, deck=document.getElementById("studyDeck").value;
 const limit=Math.max(1,Math.min(500,Number(document.getElementById("sessionLimit").value)||30));
 const newLimit=Math.max(0,Math.min(500,Number(document.getElementById("newLimit").value)||0));
 let pool=cards.filter(c=>(kind==="all"||c.kind===kind)&&deckMatch(c,deck));
 let due=pool.filter(c=>c.reps>0&&isDue(c)).sort((a,b)=>a.due-b.due);
 let fresh=pool.filter(c=>c.reps===0);
 const allowNew=Math.max(0,newLimit-newSeenToday);
 fresh=fresh.slice(0,allowNew);
 session=[...due,...fresh].slice(0,limit);
 sessionIndex=0;sessionDone=0;current=null;checked=false;
 document.getElementById("emptyStudy").classList.toggle("hidden",session.length>0);
 document.getElementById("studyArea").classList.toggle("hidden",session.length===0);
 if(session.length) nextCard(); else {document.getElementById("emptyStudy").innerHTML="<h2 class='section-title'>На сегодня всё</h2><p class='muted'>Нет карточек на повторение в выбранном фильтре. Можно изменить фильтр или добавить слова и глаголы.</p>";}
}
function nextCard(){
 if(sessionIndex>=session.length){document.getElementById("studyArea").classList.add("hidden");document.getElementById("emptyStudy").classList.remove("hidden");document.getElementById("emptyStudy").innerHTML=`<h2 class="section-title">Занятие завершено</h2><p>Проверено карточек: ${sessionDone}.</p><p class="muted">Интервалы сохранены. Можно начать новое занятие.</p><div class="actions"><button class="primary" onclick="makeSession()">Ещё занятие</button></div>`;updateStats();return;}
 current=session[sessionIndex];checked=false;
 document.getElementById("cardKind").textContent=current.kind==="verb"?"Глагол":"Слово";
 document.getElementById("cardDeck").textContent=current.kind==="verb"?`${current.language} · ${current.tense}`:current.deck;
 document.getElementById("cardProgress").textContent=`${sessionIndex+1} / ${session.length}`;
 document.getElementById("prompt").textContent=current.kind==="verb"?`${current.infinitive} — ${current.meaning}`:current.prompt;
 document.getElementById("hint").textContent=current.kind==="verb"?`Введи формы по порядку${current.pron?` · Произношение: ${current.pron}`:""}`:(current.tags?`Теги: ${current.tags}`:"");
 document.getElementById("answerInput").value="";
 document.getElementById("answerInput").disabled=false;
 document.getElementById("feedback").className="hidden";
 document.getElementById("answerBlock").classList.add("hidden");
 document.getElementById("answerInput").focus({preventScroll:true});
}
function answerText(c){return c.kind==="verb"?c.forms:c.answer}
function checkAnswer(e){
 if(e)e.preventDefault();if(!current||checked)return;
 checked=true;
 const input=normalize(document.getElementById("answerInput").value);
 const expected=normalize(answerText(current));
 const ok=input===expected;
 const fb=document.getElementById("feedback");fb.className="feedback "+(ok?"correct":"incorrect");
 fb.textContent=ok?"Правильно.":"Не совпало. Посмотри правильный ответ и оцени сложность.";
 document.getElementById("correctAnswer").textContent=current.kind==="verb"?`Формы: ${current.forms}`:`Ответ: ${current.answer}`;
 document.getElementById("pronunciation").textContent=current.pron?`Произношение: ${current.pron}`:"";
 document.getElementById("answerBlock").classList.remove("hidden");
 document.getElementById("answerInput").disabled=true;
 if(current.reps===0 && current.source!=="seed"){} 
}
document.getElementById("answerForm").addEventListener("submit",checkAnswer);
document.getElementById("showAnswerBtn").addEventListener("click",()=>{if(!checked){document.getElementById("answerInput").value="";checkAnswer();document.getElementById("feedback").textContent="Ответ показан. Оцени сложность честно.";document.getElementById("feedback").className="feedback";}});
document.getElementById("startBtn").addEventListener("click",makeSession);
document.getElementById("resetSessionBtn").addEventListener("click",()=>{session=[];sessionIndex=0;current=null;document.getElementById("studyArea").classList.add("hidden");document.getElementById("emptyStudy").classList.remove("hidden");document.getElementById("emptyStudy").innerHTML="<h2 class='section-title'>Готов к повторению</h2><p class='muted'>Нажми «Начать занятие».</p>";});
document.querySelectorAll("[data-rating]").forEach(b=>b.addEventListener("click",()=>{
 if(!current||!checked)return;
 const rating=b.dataset.rating, c=cards.find(x=>x.id===current.id);if(!c)return;
 const now=Date.now();let mins;
 if(rating==="again"){c.interval=0;c.due=now+60*1000;c.lapses=(c.lapses||0)+1;}
 else{
   if(c.reps===0){mins=rating==="hard"?10:rating==="good"?1440:4320;}
   else if(rating==="hard"){mins=Math.max(10,(c.interval||10)*1.2);}
   else if(rating==="good"){mins=Math.max(1440,(c.interval||0)*Math.max(2,c.ease||2.5));}
   else {mins=Math.max(2880,(c.interval||0)*Math.max(3,(c.ease||2.5)+1));}
   c.interval=mins;c.due=now+mins*60*1000;c.reps=(c.reps||0)+1;
   c.ease=Math.max(1.3,(c.ease||2.5)+(rating==="hard"?-.15:rating==="easy"?.15:0));
 }
 if(c.reps===0){newSeenToday++;} // counts new card's first answered rating
 save();sessionDone++;sessionIndex++;nextCard();
}));
document.getElementById("wordForm").addEventListener("submit",e=>{
 e.preventDefault();
 const c={id:uid(),kind:"word",deck:document.getElementById("wordDeck").value,prompt:document.getElementById("wordPrompt").value.trim(),answer:document.getElementById("wordAnswer").value.trim(),pron:document.getElementById("wordPron").value.trim(),tags:document.getElementById("wordTags").value.trim(),source:"user",due:0,interval:0,ease:2.5,reps:0,lapses:0};
 cards.push(c);save();e.target.reset();alert("Слово добавлено в словарь.");showTab("search");
});
document.getElementById("verbForm").addEventListener("submit",e=>{
 e.preventDefault();
 const language=document.getElementById("verbLang").value;
 const c={id:uid(),kind:"verb",deck:language==="Czech"?"Мои глаголы":"Мои глаголы",language,infinitive:document.getElementById("verbInf").value.trim(),meaning:document.getElementById("verbMeaning").value.trim(),tense:document.getElementById("verbTense").value.trim(),forms:document.getElementById("verbForms").value.trim().split(/[\n,;]+/).map(x=>x.trim()).filter(Boolean).join(", "),pron:document.getElementById("verbPron").value.trim(),source:"user",due:0,interval:0,ease:2.5,reps:0,lapses:0};
 cards.push(c);save();e.target.reset();alert("Глагол добавлен в словарь.");showTab("search");
});
function esc(s){return String(s??"").replace(/[&<>"']/g,ch=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[ch]));}
function renderSearch(){
 const q=document.getElementById("searchInput").value.toLocaleLowerCase().trim(), kind=document.getElementById("searchKind").value, source=document.getElementById("searchSource").value;
 const found=cards.filter(c=>(kind==="all"||c.kind===kind)&&(source==="all"||(source==="seed"?c.source==="Исходный словарь":c.source==="user"))&&fieldsFor(c).includes(q)).slice(0,250);
 document.getElementById("searchCount").textContent=`Найдено: ${found.length}${found.length===250?" (показаны первые 250)":""}`;
 document.getElementById("results").innerHTML=found.map(c=>`<div class="item"><div class="itemmain"><div><span class="pill">${c.kind==="verb"?"Глагол":"Слово"}</span><span class="pill">${esc(c.source||"Добавлено")}</span></div><div class="itemtitle">${esc(c.kind==="verb"?c.infinitive+" — "+c.meaning:c.prompt+" → "+c.answer)}</div><div class="muted">${esc(c.kind==="verb"?c.language+" · "+c.tense:c.deck)}${c.pron?" · "+esc(c.pron):""}</div>${c.kind==="verb"?`<div class="help">Формы: ${esc(c.forms)}</div>`:""}</div><div class="actions"><button class="smallbtn primary" onclick="trainOne('${c.id}')">Тренировать</button><button class="smallbtn" onclick="editCard('${c.id}')">Изменить</button><button class="smallbtn danger" onclick="deleteCard('${c.id}')">Удалить</button></div></div>`).join("")||"<p class='muted'>Ничего не найдено.</p>";
}
document.getElementById("searchInput").addEventListener("input",renderSearch);
document.getElementById("searchKind").addEventListener("change",renderSearch);
document.getElementById("searchSource").addEventListener("change",renderSearch);
window.trainOne=id=>{const c=cards.find(x=>x.id===id);if(!c)return;session=[c];sessionIndex=0;sessionDone=0;document.getElementById("studyArea").classList.remove("hidden");document.getElementById("emptyStudy").classList.add("hidden");showTab("study");nextCard();};
window.deleteCard=id=>{const c=cards.find(x=>x.id===id);if(!c)return;if(c.source==="Исходный словарь"&&!confirm("Это карточка из исходного словаря. Удалить её только в твоей локальной копии?"))return;if(!confirm("Удалить карточку?"))return;cards=cards.filter(x=>x.id!==id);save();renderSearch();};
window.editCard=id=>{
 const c=cards.find(x=>x.id===id);if(!c)return;
 if(c.kind==="verb"){
  const inf=prompt("Начальная форма",c.infinitive);if(inf===null)return;
  const meaning=prompt("Перевод",c.meaning);if(meaning===null)return;
  const tense=prompt("Время или тип форм",c.tense);if(tense===null)return;
  const forms=prompt("Формы по порядку (через запятую)",c.forms);if(forms===null)return;
  const pron=prompt("Произношение / подсказка",c.pron||"");if(pron===null)return;
  Object.assign(c,{infinitive:inf.trim(),meaning:meaning.trim(),tense:tense.trim(),forms:forms.trim(),pron:pron.trim()});
 }else{
  const promptText=prompt("Задание",c.prompt);if(promptText===null)return;
  const ans=prompt("Правильный ответ",c.answer);if(ans===null)return;
  const pron=prompt("Произношение / подсказка",c.pron||"");if(pron===null)return;
  Object.assign(c,{prompt:promptText.trim(),answer:ans.trim(),pron:pron.trim()});
 }
 save();renderSearch();
};
document.getElementById("exportBtn").addEventListener("click",()=>{
 const blob=new Blob([JSON.stringify({format:"language-trainer-backup-v1",exportedAt:new Date().toISOString(),cards,day:todayKey,newSeenToday},null,2)],{type:"application/json"});
 const a=document.createElement("a");a.href=URL.createObjectURL(blob);a.download="language-trainer-backup.json";a.click();URL.revokeObjectURL(a.href);
});
document.getElementById("importFile").addEventListener("change",async e=>{
 const file=e.target.files?.[0];if(!file)return;
 try{
  const obj=JSON.parse(await file.text());const incoming=Array.isArray(obj)?obj:obj.cards;
  if(!Array.isArray(incoming))throw new Error("В файле нет списка карточек.");
  if(!confirm(`Импортировать ${incoming.length} карточек? Существующие карточки с теми же ID будут заменены, остальные объединятся.`))return;
  const map=new Map(cards.map(c=>[c.id,c]));
  incoming.forEach(c=>{if(!c.id)c.id=uid();map.set(c.id,c);});
  cards=[...map.values()];save();document.getElementById("backupMsg").textContent=`Импортировано/объединено карточек: ${incoming.length}.`;renderSearch();alert("Импорт завершён.");
 }catch(err){alert("Не удалось импортировать файл: "+err.message);}
 finally{e.target.value="";}
});
load();
</script>
</body></html>
